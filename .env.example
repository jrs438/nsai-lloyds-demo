# Auth
# NOTE: To enable SSO across nsai4insurance.com and lloyds.nsai4insurance.com,
# this must be the SAME value as AUTH_SECRET in the nsai4insurance Vercel project.
AUTH_SECRET=

# Set ONLY in Production for cross-subdomain SSO with nsai4insurance.com.
# Leave empty for Preview and local dev so the session cookie stays host-only.
# The value must have a leading dot to cover both apex + subdomains.
COOKIE_DOMAIN=.nsai4insurance.com

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=demo@nsai4insurance.com
EMAIL_REPLY_TO=nsai4insurance@gmail.com
ADMIN_EMAIL=nsai4insurance@gmail.com

# Admin auth
ADMIN_PASSWORD_HASH=

# Shared viewer access code (optional) — bcrypt hash of a passphrase.
# When set, a "Have an access code?" box appears on /lloyds/signin that
# grants a read-only viewer session without email approval.
ACCESS_CODE_HASH=

# Database
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# App
NEXT_PUBLIC_BASE_URL=https://lloyds.nsai4insurance.com
